# AI Trader - Environment Configuration
# Copy this to .env and add your values

# ===================
# APP SETTINGS
# ===================
APP_NAME=AI Trader
ENV=development   # development | production (production hides /docs and brain details)
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000  # never set to "*" when using credentials

# Security — optional API key for write endpoints (paper trading, ARTH chat, omniroute test)
# Leave empty in local dev; set in production (sent as X-API-Key or Bearer)
ARTH_API_KEY=
ALLOW_PRIVATE_OMNIROUTE=false  # set true only if OmniRoute runs on private IP (SSRF guard)
MAX_WS_CONNECTIONS=100

# ===================
# TRADING PARAMETERS
# ===================
RSI_PERIOD=14
SMA_SHORT=20
SMA_MID=50
SMA_LONG=200
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MIN_SIGNAL_CONFIDENCE=60
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ===================
# DATABASE
# ===================
DATABASE_URL=sqlite:///./ai_trader.db

# ===================
# LOGGING
# ===================
LOG_LEVEL=INFO

# ===================
# AI PROVIDERS (Phase 2+)
# ===================
# ——— OmniRoute — Unified Gateway (RECOMMENDED) ———
# OmniRoute aggregates 356 providers (150+ free tiers, ~1.47B free tokens/mo)
# behind ONE OpenAI-compatible endpoint. This single key replaces many.
# Reference: https://github.com/diegosouzapw/OmniRoute
# Quick start:
#   1. Install & run OmniRoute: npm install -g omniroute && omniroute
#      → Dashboard at http://localhost:20128  → create API key
#   2. Set OMNIROUTE_API_KEY below (or leave empty for keyless local dev)
#   3. Restart backend — ARTH will route via OmniRoute first (auto fallback)
# Docker: set OMNIROUTE_BASE_URL=http://omniroute:20128/v1
# Hosted: set to https://your-omniroute.host/v1
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
# Variants: auto/fast (lowest latency), auto/cheap (cheapest), auto/smart (quality+explore), auto/coding, auto/offline
OMNIROUTE_TIMEOUT=90

# AI Priority order (omniroute first unlocks 356 providers; fallback to direct)
# Example: omniroute,groq,cohere,huggingface,ollama
AI_PRIORITY=omniroute,groq,cohere,huggingface,ollama

# Groq (Fastest free AI)
GROQ_API_KEY=

# Cohere
COHERE_API_KEY=

# HuggingFace
HUGGINGFACE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Ollama (Local - runs automatically if installed)
OLLAMA_API_KEY=

# OpenAI (Optional - Premium, direct)
OPENAI_API_KEY=

# Anthropic Claude (Optional, direct)
ANTHROPIC_API_KEY=

# ===================
# 4 SELF-LEARNING ENGINES
# ===================
# News & Sentiment (Engine #1) — requires NEWSAPI_KEY or uses feed fallback
NEWSAPI_KEY=
ENABLE_NEWS=false
# Fundamentals & Finance (Engine #2) — uses yfinance (free), optional AI scoring
ENABLE_FUNDAMENTALS=true
# Math & Risk (Engine #3) — Kelly, Sharpe, ATR risk model (always safe)
ENABLE_MATH_ENGINE=true
ENABLE_AUTO_STRATEGY=false  # Engine #4 — auto-generate rules every 6h (requires brain history)

# Backtesting
ENABLE_BACKTESTING=true
