# AI Trader - Environment Configuration
# Copy this to .env and add your values

# ===================
# APP SETTINGS
# ===================
APP_NAME=AI Trader
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000

# ===================
# TRADING PARAMETERS
# ===================
RSI_PERIOD=14
SMA_SHORT=20
SMA_MID=50
SMA_LONG=200
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MIN_SIGNAL_CONFIDENCE=60
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ===================
# DATABASE
# ===================
DATABASE_URL=sqlite:///./ai_trader.db

# ===================
# LOGGING
# ===================
LOG_LEVEL=INFO

# ===================
# AI PROVIDERS (Phase 2+)
# ===================
# Groq (Fastest free AI)
GROQ_API_KEY=

# Cohere
COHERE_API_KEY=

# HuggingFace
HUGGINGFACE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Ollama (Local - runs automatically if installed)
OLLAMA_API_KEY=

# OpenAI (Optional - Premium)
OPENAI_API_KEY=

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=
