#!/bin/bash

# =====================================================
# AI Trader - Pre-commit Task Automation
# =====================================================
# This file runs before every git commit to ensure
# code quality and clean repository state
# =====================================================

set -e  # Exit on error

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔍 AI Trader - Pre-commit Checks"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Track errors
ERRORS=0
WARNINGS=0

# =====================================================
# 1. CLEAN PLAN FILES (Required by project rules)
# =====================================================
echo ""
echo "🧹 Cleaning up plan and temporary files..."

# Files to remove before commit
PLAN_FILES=(
    "PLAN.md"
    "TODO.md"
    "*.tmp"
    ".plan"
    "CHANGELOG_DRAFT.md"
    "TEMP_*"
    "DEBUG_*"
)

for pattern in "${PLAN_FILES[@]}"; do
    if ls $pattern 1> /dev/null 2>&1; then
        echo "  ✓ Removed: $pattern"
        rm -f $pattern
    fi
done

# Check if we should continue (skip if clean-only)
if [ "$1" = "--clean-only" ]; then
    echo ""
    echo "✅ Clean complete!"
    exit 0
fi

# =====================================================
# 2. DISPLAY PHASE STATUS
# =====================================================
echo ""
echo "📊 Current Implementation Phase:"
if [ -f "backend/main.py" ]; then
    echo -e "  ${GREEN}✓ Phase 1+ started${NC}"
else
    echo -e "  ${YELLOW}○ Phase 1 not started yet${NC}"
fi

# =====================================================
# 3. CODE FORMATTING
# =====================================================
echo ""
echo "📝 Formatting code..."

# Python formatting (black)
if command -v black &> /dev/null; then
    if [ -d "backend" ]; then
        echo "  Running black on backend..."
        black backend/ --line-length 100 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ black had formatting issues${NC}"
            ERRORS=$((ERRORS+1))
        }
    fi
else
    echo -e "  ${YELLOW}⚠ black not installed (optional)${NC}"
fi

# Python linting (ruff)
if command -v ruff &> /dev/null; then
    if [ -d "backend" ]; then
        echo "  Running ruff on backend..."
        ruff check backend/ --fix 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ ruff had issues${NC}"
            ERRORS=$((ERRORS+1))
        }
    fi
else
    echo -e "  ${YELLOW}⚠ ruff not installed (optional)${NC}"
fi

# TypeScript/JavaScript formatting (prettier)
if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    if command -v npx &> /dev/null; then
        echo "  Running prettier on frontend..."
        cd frontend
        npx prettier --write "src/**/*.{tsx,ts,jsx,js}" 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ prettier had issues${NC}"
            ERRORS=$((ERRORS+1))
        }
        cd ..
    fi
fi

# =====================================================
# 4. TYPE CHECKING
# =====================================================
echo ""
echo "🔍 Type checking..."

# TypeScript check
if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    if command -v npx &> /dev/null; then
        echo "  Running TypeScript compiler..."
        cd frontend
        npx tsc --noEmit 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ TypeScript had type errors${NC}"
            ERRORS=$((ERRORS+1))
        }
        cd ..
    fi
fi

# Python type checking (mypy)
if command -v mypy &> /dev/null; then
    if [ -d "backend" ]; then
        echo "  Running mypy..."
        mypy backend/ 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ mypy had issues${NC}"
            ERRORS=$((ERRORS+1))
        }
    fi
fi

# =====================================================
# 5. TESTING
# =====================================================
echo ""
echo "🧪 Running tests..."

# Python tests
if [ -d "backend/tests" ] || [ -d "tests" ]; then
    if command -v pytest &> /dev/null; then
        echo "  Running pytest..."
        pytest backend/ -v --tb=short 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ Some tests failed${NC}"
            ERRORS=$((ERRORS+1))
        }
    else
        echo -e "  ${YELLOW}⚠ pytest not installed (tests skipped)${NC}"
    fi
else
    echo -e "  ${YELLOW}○ No tests directory found${NC}"
fi

# Frontend tests
if [ -d "frontend/src/__tests__" ] || [ -d "frontend/test" ]; then
    if command -v npx &> /dev/null; then
        echo "  Running frontend tests..."
        cd frontend
        npx jest 2>/dev/null || {
            echo -e "  ${YELLOW}⚠ Frontend tests had issues${NC}"
            ERRORS=$((ERRORS+1))
        }
        cd ..
    fi
fi

# =====================================================
# 6. SECURITY CHECKS
# =====================================================
echo ""
echo "🔒 Security checks..."

# Check for exposed API keys in code
if grep -rn "ghp_\|sk-\|api_key\s*=\s*['\"]" --include="*.py" --include="*.ts" --include="*.tsx" backend/ frontend/src/ 2>/dev/null | grep -v ".env" | grep -v ".env.example" | grep -v "config.py" | grep -v "# api_key"; then
    echo -e "  ${RED}⚠ WARNING: Possible API keys found in code!${NC}"
    echo "    Make sure you're using .env files only!"
    ERRORS=$((ERRORS+1))
else
    echo -e "  ${GREEN}✓ No exposed API keys found${NC}"
fi

# Verify .env.example exists
if [ ! -f ".env.example" ]; then
    echo -e "  ${YELLOW}⚠ .env.example not found${NC}"
fi

# Verify .env is in .gitignore
if [ -f ".env" ] && ! grep -q ".env" .gitignore 2>/dev/null; then
    echo -e "  ${RED}⚠ .env is not in .gitignore!${NC}"
    ERRORS=$((ERRORS+1))
fi

# =====================================================
# 7. GIT CHECKS
# =====================================================
echo ""
echo "📦 Git checks..."

# Check staged files
STAGED=$(git diff --cached --name-only 2>/dev/null | wc -l)
echo "  Staged files: $STAGED"

if [ $STAGED -eq 0 ]; then
    echo -e "  ${YELLOW}⚠ No files staged${NC}"
fi

# Check for large files
LARGE_FILES=$(find . -name "*.pyc" -o -name "__pycache__" -o -name "node_modules" -o -name ".next" 2>/dev/null | head -3)
if [ -n "$LARGE_FILES" ]; then
    echo "  Generated directories found (will be ignored):"
    echo "$LARGE_FILES" | head -2 | sed 's/^/    /'
fi

# Verify gitignore
if ! grep -q "node_modules" .gitignore 2>/dev/null; then
    echo -e "  ${YELLOW}⚠ node_modules not in .gitignore${NC}"
fi

# =====================================================
# 8. ARTH (AI) CHECKS
# =====================================================
if [ -d "backend/ai_agent" ]; then
    echo ""
    echo "🤖 ARTH AI Agent checks..."
    
    # Check if prompts are defined
    if [ -f "backend/ai_agent/prompts.py" ]; then
        echo -e "  ${GREEN}✓ ARTH prompts defined${NC}"
    fi
    
    # Check if brain module exists
    if [ -f "backend/ai_agent/brain.py" ]; then
        echo -e "  ${GREEN}✓ ARTH brain module exists${NC}"
    fi
fi

# =====================================================
# 9. DATABASE CHECKS
# =====================================================
if [ -f "backend/database/connection.py" ]; then
    echo ""
    echo "🗄️  Database checks..."
    
    # Check migrations exist
    if [ -d "backend/database/migrations" ]; then
        echo -e "  ${GREEN}✓ Database migrations exist${NC}"
    fi
fi

# =====================================================
# SUMMARY
# =====================================================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $ERRORS -eq 0 ]; then
    echo -e "✅ ${GREEN}All checks passed! Ready to commit.${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Review staged changes: git diff --cached"
    echo "  2. Commit: git commit -m 'Your message'"
    echo "  3. Push: git push"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 0
else
    echo -e "⚠️  ${YELLOW}$ERRORS error(s) found. Review above.${NC}"
    echo ""
    echo "To skip checks (not recommended): git commit --no-verify"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 1
fi
